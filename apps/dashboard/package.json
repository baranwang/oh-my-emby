    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-router": "^1.170.38",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "effect": "4.0.0-rc.112",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.25.4",
    "@tailwindcss/vite": "^4.3.3",
